# ── Server ──────────────────────────────────────────────
PORT=4000

# ── Supabase ────────────────────────────────────────────
# Leave these blank to run on local JSON file storage (no setup needed).
# Fill them in once you create your Supabase project to switch to real persistence.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Primary admin login ─────────────────────────────────
# This account can always log into /admin, whether or not Supabase is
# configured. It is checked BEFORE Supabase Auth, so filling in the Supabase
# vars above can never lock the primary admin out.
# If you leave these blank, the defaults in server/routes/admin.js are used.
# DEV_ADMIN_EMAIL / DEV_ADMIN_PASSWORD are the older names and still work.
ADMIN_EMAIL=midge2100@gmail.com
ADMIN_PASSWORD=teen4teen

# ── Gemini API (AI mock session) ───────────────────────
# Leave blank to use the built-in scripted demo conversation instead.
GEMINI_API_KEY=

# ── Email notifications (Resend) ───────────────────────
# Leave blank to skip emails — actions still work, just silently skip notifying.
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=admin@teen4teen.org
# Until a custom domain is verified in Resend, sends must come from their
# shared test address and can only be DELIVERED to the email you signed up
# with. Once you verify a domain, change this to e.g. "Teen4Teen <hello@teen4teen.org>".
RESEND_FROM_EMAIL=Teen4Teen <onboarding@resend.dev>

# ── Base URL ────────────────────────────────────────────
# Used to build links inside emails (e.g. the seeker's private chat link).
# Local dev default is fine as-is; update to your real Render/Hostinger URL
# once deployed.
BASE_URL=http://localhost:5173
